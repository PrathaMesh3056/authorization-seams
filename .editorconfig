root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown,yml,yaml,json,cff,toml}]
indent_size = 2

[*.ps1]
indent_size = 4

[Makefile]
indent_style = tab

# Frozen experiment artifacts: never rewrite these on save.
[tests/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[paper/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
